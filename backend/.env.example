# =====================================================================
# Nyaya AI Backend Production & Development Environment Template
# =====================================================================
# Copy this file to '.env' in local development or configure in host settings.
# NEVER commit real secret keys or production passwords to version control.

# ---------------------------------------------------------------------
# Application Settings
# ---------------------------------------------------------------------
APP_NAME=Nyaya AI Legal Assistance API
APP_VERSION=1.0.0
ENVIRONMENT=development  # development | test | production
PORT=8000
RELEASE_ID=dev-local

# ---------------------------------------------------------------------
# Database Configuration (MongoDB)
# ---------------------------------------------------------------------
# For production, use mongodb+srv:// with TLS enabled.
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=ai_legal_assistance

# ---------------------------------------------------------------------
# Authentication & Cryptography
# ---------------------------------------------------------------------
# Must contain at least 32 UTF-8 bytes. Generate with `openssl rand -hex 32`
JWT_SECRET=your_32_byte_minimum_secure_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------------------------------------------------------------------
# Security, CORS & Trusted Hosts
# ---------------------------------------------------------------------
# Comma-separated list of explicit frontend origins. Wildcards (*) cannot be used with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://nyaya-ai.org,https://app.nyaya-ai.org
ALLOWED_HOSTS=localhost,127.0.0.1,testserver,nyaya-ai.org,app.nyaya-ai.org

# ---------------------------------------------------------------------
# LLM Provider Configuration
# ---------------------------------------------------------------------
LLM_PROVIDER=openrouter  # openrouter | openai
LLM_API_KEY=your_openrouter_or_openai_api_key_here
LLM_MODEL=openrouter/free

# ---------------------------------------------------------------------
# File Storage & Evidence Vault
# ---------------------------------------------------------------------
STORAGE_BACKEND=local  # local | s3
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
MAX_AUDIO_UPLOAD_SIZE_MB=25
MAX_VIDEO_UPLOAD_SIZE_MB=50

# S3 Object Storage (Required when STORAGE_BACKEND=s3)
# OBJECT_STORAGE_BUCKET=nyaya-evidence-vault
# OBJECT_STORAGE_REGION=ap-south-1
# OBJECT_STORAGE_ENDPOINT=
# OBJECT_STORAGE_ACCESS_KEY=
# OBJECT_STORAGE_SECRET_KEY=

# ---------------------------------------------------------------------
# Operational Infra (Optional)
# ---------------------------------------------------------------------
RATE_LIMIT_BACKEND=memory  # memory | redis
# REDIS_URL=redis://localhost:6379/0
MALWARE_SCANNER_TYPE=mock  # mock | clamav | disabled