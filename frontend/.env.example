# =====================================================================
# Nyaya AI Frontend Environment Template
# =====================================================================
# In production, VITE_API_BASE_URL should point to your backend API domain
# (e.g. https://api.nyaya-ai.org). Leave empty when serving behind reverse proxy.

# Backend API Base URL (Do NOT hardcode localhost in production builds)
VITE_API_BASE_URL=

# Local Vite proxy target (Used during local dev server proxying)
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
